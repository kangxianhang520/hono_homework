{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"test": "vitest run",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@my-better-t-app/db": "workspace:*",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@my-better-t-app/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:",
		"vitest": "^5.1.0"
	}
}
